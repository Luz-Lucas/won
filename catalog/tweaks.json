{
  "tweaks": [
    {
      "id": "game-mode",
      "title": "Modo de Jogo",
      "description": "Deixa o Modo de Jogo do Windows ativo, priorizando o jogo em primeiro plano. Normalmente ele já vem ligado de fábrica; aqui a opção fica gravada de forma explícita. Efeito imediato; sem custo conhecido.",
      "group": "jogos",
      "evidence": "comprovado",
      "effect": "immediate",
      "needs_admin": false,
      "laptop_warning": false,
      "recommended": true,
      "source": "https://raw.githubusercontent.com/ChrisTitusTech/winutil/main/config/tweaks.json",
      "actions": [
        {
          "kind": "registry",
          "hive": "HKCU",
          "path": "Software\\Microsoft\\GameBar",
          "name": "AutoGameModeEnabled",
          "value": {
            "type": "dword",
            "data": 1
          }
        }
      ]
    },
    {
      "id": "game-dvr-off",
      "title": "Desligar gravação em segundo plano (Game DVR)",
      "description": "Desativa a gravação e as capturas do Xbox Game Bar, inclusive a gravação em segundo plano, que consome CPU/GPU e pode limitar o FPS. Você deixa de gravar vídeos e tirar capturas pela Game Bar.",
      "group": "jogos",
      "evidence": "comprovado",
      "effect": "immediate",
      "needs_admin": false,
      "laptop_warning": false,
      "recommended": true,
      "source": "https://learn.microsoft.com/en-us/answers/questions/2757834/frame-caps-in-games-due-to-gamedvr",
      "actions": [
        {
          "kind": "registry",
          "hive": "HKCU",
          "path": "System\\GameConfigStore",
          "name": "GameDVR_Enabled",
          "value": {
            "type": "dword",
            "data": 0
          }
        },
        {
          "kind": "registry",
          "hive": "HKCU",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\GameDVR",
          "name": "AppCaptureEnabled",
          "value": {
            "type": "dword",
            "data": 0
          }
        }
      ]
    },
    {
      "id": "hags",
      "title": "Agendamento de GPU acelerado por hardware (HAGS)",
      "description": "Deixa a própria placa de vídeo agendar o trabalho da GPU, em vez do processador, o que pode reduzir latência. Exige reinício. Em algumas placas antigas pode piorar; desfaça se notar travamentos.",
      "group": "jogos",
      "evidence": "comprovado",
      "effect": "reboot",
      "needs_admin": true,
      "laptop_warning": false,
      "recommended": true,
      "source": "https://learn.microsoft.com/en-us/answers/questions/4358192/where-did-hardware-accellerated-gpu-scheduling-go",
      "actions": [
        {
          "kind": "registry",
          "hive": "HKLM",
          "path": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
          "name": "HwSchMode",
          "value": {
            "type": "dword",
            "data": 2
          }
        }
      ]
    },
    {
      "id": "windowed-optimizations",
      "title": "Otimizações para jogos em janela",
      "description": "Ativa o modelo de apresentação moderno e o VRR para jogos em janela ou sem borda, com menos latência. Só afeta jogos DirectX 10/11 antigos; sem custo conhecido.",
      "group": "jogos",
      "evidence": "comprovado",
      "effect": "immediate",
      "needs_admin": false,
      "laptop_warning": false,
      "recommended": true,
      "source": "https://devblogs.microsoft.com/directx/updates-in-graphics-and-gaming/",
      "actions": [
        {
          "kind": "list_entry",
          "hive": "HKCU",
          "path": "Software\\Microsoft\\DirectX\\UserGpuPreferences",
          "name": "DirectXUserGlobalSettings",
          "key": "SwapEffectUpgradeEnable",
          "value": "1"
        },
        {
          "kind": "list_entry",
          "hive": "HKCU",
          "path": "Software\\Microsoft\\DirectX\\UserGpuPreferences",
          "name": "DirectXUserGlobalSettings",
          "key": "VRROptimizeEnable",
          "value": "1"
        }
      ]
    },
