      VALUE "OriginalFilename", "sentinela.exe"
      VALUE "ProductName", "WON - Windows Optimization Nest"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 0x04B0
  END
END
